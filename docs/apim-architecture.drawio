uto&lt;/b&gt;&lt;br&gt;/chat/completions&lt;br&gt;header api-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D1DC;fontSize=12;fontColor=#1A2733;align=center;verticalAlign=middle;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="180" width="160" height="150" as="geometry"/></mxCell><mxCell id="c8" value="Pinned classes still work:&lt;br&gt;/deployments/small, strong&lt;br&gt;or code (no router call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6F5;fontSize=11;fontColor=#1A2733;align=center;verticalAlign=middle;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="45" y="360" width="160" height="120" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="56" height="56" as="geometry"/></mxCell><mxCell id="c10" value="API Management&lt;br&gt;gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A2733;align=center;verticalAlign=top;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="253.0" y="178" width="150" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Inbound policy (infra/apim/policy-auto.xml)&lt;/b&gt;&lt;br&gt;1  Extract last user message&lt;br&gt;2  send-request → router (timeout 3 s)&lt;br&gt;3  Fail-safe → strong on timeout / non-200 / conf &lt; 0.6&lt;br&gt;4  rate-limit (Consumption) · llm-token-limit on v2 tiers&lt;br&gt;5  set-backend-service → pool-{class}&lt;br&gt;6  authentication-managed-identity → AOAI&lt;br&gt;7  code class: chat → Responses API translation&lt;br&gt;8  llm-emit-token-metric {routed-model, route-source}&lt;br&gt;out  x-routed-model · x-route-source · x-route-confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9A9EE;fontSize=11;fontColor=#1A2733;align=left;verticalAlign=top;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="105" width="380" height="240" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Backends + pools (circuit breaker: 3× 429/5xx in 1 min → trip 1 min)&lt;/b&gt;&lt;br&gt;pool-small: nano (p1) → 5.4 (p2)&lt;br&gt;pool-strong: 5.4&lt;br&gt;pool-code: codex (Responses API only, no cross-model failover)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9A9EE;fontSize=11;fontColor=#1A2733;align=left;verticalAlign=top;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="380" height="110" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="290" y="420" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value="Key Vault&lt;br&gt;named value jev-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A2733;align=center;verticalAlign=top;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="239.0" y="470" width="150" height="40" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="290" y="555" width="44" height="44" as="geometry"/></mxCell><mxCell id="c16" value="APIM system-assigned MI (Entra ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1A2733;align=center;verticalAlign=top;arcSize=5;spacing=8;" vertex="1" parent="1"><mxGeometry x="232.0" y="601" width="160" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Router API&lt;/b&gt;&lt;br&gt;POST /api/router/route&lt;br&gt;returns {choice, probabilities, confidence}&lt;br&gt;&lt;i&gt;option A: Jev Choice (hosted)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D1DC;fontSize=12;fontColor=#1A2733;align=center;verticalAlign=middle;arcSize=5;spacing=8;" vertex=